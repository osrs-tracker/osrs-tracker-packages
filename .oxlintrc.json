// The oxlint config of every package in packages/ (each one's `lint` script passes it with -c). It started as a copy of
// osrs-tracker-aws's lambda/shared/.oxlintrc.json, the Lambdas' config, and is kept separately from it here.
//
// oxlint stands in for ESLint with typescript-eslint until typescript-eslint supports TypeScript 7
// (osrs-tracker/osrs-tracker-aws#143): it parses
// TypeScript itself, with no `typescript` dependency. Only the rules the ESLint config had, so the way back changes
// nothing: oxlint's default `correctness` category is off, and ESLint's deprecated `no-return-await` has no oxlint
// equivalent.
// Formatting is Prettier's (the root .prettierrc.json): no rule here may overlap it. oxlint skips what .gitignore lists
// (dist/, node_modules).
{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "off"
  },
  "env": {
    "node": true,
    "es2024": true
  },
  "rules": {
    "no-redeclare": "error",
    "prefer-const": "error"
  }
}
