    "knip": "knip",
    "prettier": "prettier --write .",
    "prettier:ci": "prettier --check ."
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "knip": "^6.41.0",
    "oxlint": "^1.88.0",
    "prettier": "^3.5.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "allowScripts": {
    "mongodb-memory-server@11.3.0": true
  }
}
