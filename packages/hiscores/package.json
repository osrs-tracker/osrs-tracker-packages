{
  "name": "@osrs-tracker/hiscores",
  "version": "6.0.0",
  "description": "Helpers for OSRS hiscores and the world list: a hiscore client, a player count from the world list, the mapping from Jagex's JSON and snapshot diffs",
  "license": "Apache-2.0",
  "author": "Freek Mencke",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "files": [
    "dist",
    "CHANGELOG.md",
    "NOTICE"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/osrs-tracker/osrs-tracker-packages.git",
    "directory": "packages/hiscores"
  },
  "scripts": {
    "build": "../../scripts/build-package.sh",
    "typecheck": "tsc -p tsconfig.spec.json",
    "prepublishOnly": "npm run build",
    "lint": "oxlint -c ../../.oxlintrc.json"
  },
  "peerDependencies": {
    "@osrs-tracker/models": "^2.4.0 || ^3.0.0"
  },
  "devDependencies": {
    "@osrs-tracker/models": "^3.0.0"
  }
}
