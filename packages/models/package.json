{
  "name": "@osrs-tracker/models",
  "version": "3.2.0",
  "description": "Typings for OSRS Tracker API",
  "license": "Apache-2.0",
  "author": "Freek Mencke",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist",
    "CHANGELOG.md",
    "NOTICE"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/osrs-tracker/osrs-tracker-packages.git",
    "directory": "packages/models"
  },
  "scripts": {
    "build": "../../scripts/build-package.sh --declarationMap",
    "typecheck": "tsc -p tsconfig.spec.json",
    "prepublishOnly": "npm run build",
    "lint": "oxlint -c ../../.oxlintrc.json"
  },
  "devDependencies": {
    "mongodb": "^7.7.0",
    "mongodb-memory-server": "^11.3.0"
  }
}
